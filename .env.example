# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Default: gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash

# Alternative env name supported by the analyze route (same value as GEMINI_API_KEY):
# GOOGLE_GENERATIVE_AI_API_KEY=

# Optional: Comic Vine — enriches year and volume/series when Gemini + search match an issue
COMIC_VINE_API_KEY=

# Post-confirmation lookup: Brave Search API (“Tell me about {comic}”). Vercel example name:
ComicInfo_Brave_Search=
# Aliases supported in code:
# BRAVE_SEARCH_API_KEY=
# BRAVE_API_KEY=

# Optional: append each successful lookup as a row to Google Sheets (eBay staging).
# Create a service account in Google Cloud, enable Google Sheets API, download JSON key.
# Share the spreadsheet with the service account email (Editor).
GOOGLE_SHEETS_SPREADSHEET_ID=
# Entire JSON on one line, or use Vercel multiline secret:
GOOGLE_SHEETS_CREDENTIALS=
# Optional. Tab name inside the spreadsheet (default: Sheet1)
# GOOGLE_SHEETS_TAB_NAME=Sheet1
