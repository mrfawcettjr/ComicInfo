# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Default: gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash

# Alternative env name supported by the analyze route (same value as GEMINI_API_KEY):
# GOOGLE_GENERATIVE_AI_API_KEY=

# Optional: Comic Vine — enriches year and volume/series when Gemini + search match an issue
COMIC_VINE_API_KEY=

# Post-confirmation lookup: Brave Search API (“Tell me about {comic}”). Vercel example name:
ComicInfo_Brave_Search=
# Aliases supported in code:
# BRAVE_SEARCH_API_KEY=
# BRAVE_API_KEY=

# Optional: enable the “Add row to Google Sheet” button (manual upload only — nothing is sent
# until you click it). eBay staging columns. Service account + Sheets API; share sheet (Editor).
GOOGLE_SHEETS_SPREADSHEET_ID=
# Entire JSON on one line, or use Vercel multiline secret:
GOOGLE_SHEETS_CREDENTIALS=
# Optional. Tab name inside the spreadsheet (default: Sheet1)
# GOOGLE_SHEETS_TAB_NAME=Sheet1

# Optional: “Publish on eBay (7-day auction)” after adding a sheet row (Sell Inventory API).
# Production OAuth + business policies from developer.ebay.com.
# Sheet photo_urls are uploaded with the Commerce Media API (createImageFromUrl) to EPS, then
# those URLs are sent to Inventory; same OAuth scope as Inventory (sell.inventory).
# Sheet row must include price (USD), photo_urls (HTTPS), and merchant_location_key unless set here.
EBAY_PROD_CLIENT_ID=
EBAY_PROD_CLIENT_SECRET=
EBAY_PROD_REFRESH_TOKEN=
EBAY_PROD_FULFILLMENT_POLICY_ID=
EBAY_PROD_PAYMENT_POLICY_ID=
EBAY_PROD_RETURN_POLICY_ID=
# Optional if every row sets merchant_location_key in the sheet:
# EBAY_PROD_MERCHANT_LOCATION_KEY=
# Optional. Default US Comics category when ebay_category_id is empty:
# EBAY_PROD_DEFAULT_CATEGORY_ID=261186
# EBAY_PROD_MARKETPLACE_ID=EBAY_US

# Production safeguards:
EBAY_ALLOW_PROD_WRITES=false
EBAY_DRY_RUN=true
EBAY_PUBLISH_CONFIRM_TOKEN=PUBLISH_EBAY_PROD
