# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Default: gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash

# Alternative env name supported by the analyze route (same value as GEMINI_API_KEY):
# GOOGLE_GENERATIVE_AI_API_KEY=

# Optional: Comic Vine — enriches year and volume/series when Gemini + search match an issue
COMIC_VINE_API_KEY=

# Required for post-confirmation web search (Google Programmable Search JSON API)
# Create a Search Engine at https://programmablesearchengine.google.com/
GOOGLE_CUSTOM_SEARCH_API_KEY=
GOOGLE_CUSTOM_SEARCH_ENGINE_ID=
